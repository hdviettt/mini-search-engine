# Copy to .env and fill in. Never commit .env.

# Postgres with the pgvector extension.
DATABASE_URL=postgresql://searchengine:searchengine@localhost:5432/searchengine

# AI Overview generation — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chunk embeddings — https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Live sports OneBox — https://www.api-football.com (optional)
FOOTBALL_API_KEY=

# Required to use operational endpoints (crawl, index, embed, schedules).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, those endpoints return 503 instead of running unprotected.
ADMIN_API_KEY=

# Where "/" redirects to. Defaults to the deployed frontend.
FRONTEND_URL=http://localhost:3000

# Set only if the reranker model lives outside backend/models/reranker.
# RERANKER_MODEL_DIR=
